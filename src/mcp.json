{
  "servers": {
    "expense-policy-storage": {
      "type": "http",
      "url": "$POLICY_MCP_SERVER_URL",
      "tools": [
        "azureblob_ListFolder_V4",
        "azureblob_GetFileContentByPath_V2"
      ],
      "auth": {
        "scope": "https://apihub.azure.com/.default",
        "client_id": "$POLICY_MCP_CLIENT_ID"
      }
    },
    "expense-dataverse": {
      "type": "http",
      "url": "$DATAVERSE_MCP_SERVER_URL",
      "tools": [
        "commondataservice_PatchItem_V2"
      ],
      "auth": {
        "scope": "https://apihub.azure.com/.default",
        "client_id": "$DATAVERSE_MCP_CLIENT_ID"
      }
    }
  }
}
